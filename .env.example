# Copy this file to .env in the repository root.
# The Next.js app and the Python scripts read that file.
# Use an empty demo database. The loader deletes Mini-ASTR labels before it writes.
#
# Local Docker uses bolt://localhost:7687.
# Aura uses neo4j+s://<id>.databases.neo4j.io and the password Aura generated.
# On Vercel, set FACE_SERVICE_URL to the Render URL, for example https://mini-astr-face.onrender.com.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mini-astr-demo
FACE_SERVICE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the face service directly.
# The Vercel site does not need this, because the browser talks to Next.js.
# CORS_ORIGINS=https://mini-astr.vercel.app

# Cosine similarity above this value creates a SIMILAR_TO link.
# Facenet512 on LFW photos is often lower than 0.8 across pose and lighting.
# If planted duplicates are not grouped, try 0.65 and run cluster again.
SIMILARITY_THRESHOLD=0.8

# rapidfuzz token_sort_ratio above this value treats names as near-duplicates.
FUZZY_NAME_THRESHOLD=85
